{
  "manifest_version": 3,
  "name": "Chatterly Login Capture",
  "version": "1.0.0",
  "description": "One-click OnlyFans login that produces a curl command for the Chatterly relay.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "cookies", "clipboardWrite"],
  "host_permissions": [
    "https://onlyfans.com/*",
    "https://*.onlyfans.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chatterly Login Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://onlyfans.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://onlyfans.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": []
}
