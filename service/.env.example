# Copy to service/.env (gitignored). Fill values per environment.

# Relay share-link gate. Bare `docker compose up` uses the default below if unset.
# Generate a fresh one with: openssl rand -hex 24
SHARE_TOKEN=

# SQLAlchemy connection string.
# SQLite default — phase A. Switch to postgresql+asyncpg://... when you scale.
DATABASE_URL=sqlite+aiosqlite:///./service/chatterly.db

# Grok / xAI — used by service/ai/ in phase E. Required before any AI call.
# Get a key at https://console.x.ai/. The plan's $1/day soft cap is enforced
# in service/ai/grok.py regardless of what's set here.
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-non-reasoning

# Capture sidecar reachability (legacy — kept for back-compat with old configs).
# CAPTURE_HOST=127.0.0.1
